{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "type": "remote",
      "enabled": true
    },
    "t3": {
      "url": "https://t3.p.kalski.xyz/mcp",
      "type": "remote",
      "enabled": true
    }
  },
  "provider": {
    "pannu-ollama": {
      "id": "pannu-ollama",
      "name": "Pannu Ollama",
      "api": "ollama",
      "options": {
        "baseURL": "https://ollama.p.kalski.xyz/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "id": "qwen3.5:9b",
          "name": "Qwen3.5 9B",
          "tool_call": true,
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.5:35b": {
          "id": "qwen3.5:35b",
          "name": "Qwen3.5 35B",
          "tool_call": true,
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker inspect *": "allow",
      "which *": "allow",
      "gh pr view *": "allow",
      "gh issue view *": "allow",
      "gh run view *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "mkdir *": "allow",
      "wc *": "allow",
      "tail *": "allow",
      "head *": "allow"
    }
  }
}
