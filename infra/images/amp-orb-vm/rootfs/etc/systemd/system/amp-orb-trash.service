# Deletes the system layer an image change moved aside, after the orb is up.
[Unit]
Description=Delete the orb's previous system layer
After=amp-headless-bootstrap.service
ConditionDirectoryNotEmpty=/run/orb/state/trash

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/bin/sh -c 'rm -rf /run/orb/state/trash/*'

[Install]
WantedBy=multi-user.target
