# Docker keeps its images in containerd's store, whose overlayfs snapshotter
# cannot extract layers with whiteouts on the overlay root, so its data lives
# directly on the state disk, like Docker's own.
[Unit]
Description=containerd data on the orb's state disk
Before=docker.service containerd.service

[Mount]
What=/run/orb/state/containerd
Where=/var/lib/containerd
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
