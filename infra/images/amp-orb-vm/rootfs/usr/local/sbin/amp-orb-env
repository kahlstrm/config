#!/bin/sh
# Writes ORB_TOKEN and AMP_URL from the Secret the dispatch program attaches as a
# disk into the env file of Amp's bootstrap unit. A resumed orb has a new spawn's
# disk behind the same device, so drop any cached blocks first.
# Skip the CLI update Amp's unit would otherwise download before every start;
# amp-orb-cli-update.service runs it in the background instead.
set -eu
disk=/dev/disk/by-id/virtio-orbenv
env_file=/home/user/.config/amp/headless-bootstrap.env
mkdir -p /mnt/orb-env "$(dirname "$env_file")"
blockdev --flushbufs "$disk"
mount -o ro "$disk" /mnt/orb-env
umask 077
for key in ORB_TOKEN AMP_URL; do
  if [ -f "/mnt/orb-env/$key" ]; then printf '%s=%s\n' "$key" "$(cat "/mnt/orb-env/$key")"; fi
done >"$env_file"
touch /home/user/.amp/skip-next-headless-update
chown user:user "$env_file" /home/user/.amp/skip-next-headless-update
umount /mnt/orb-env
