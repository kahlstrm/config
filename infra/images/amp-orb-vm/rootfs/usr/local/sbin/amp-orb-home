#!/bin/sh
# Mounts the orb's persistent home disk over /home/user, seeding a new disk from
# the image's home directory, which holds the Amp CLI and its dotfiles.
set -eu
disk=/dev/disk/by-id/virtio-home
blkid "$disk" >/dev/null 2>&1 || mkfs.ext4 -q -L orb-home "$disk"
mkdir -p /mnt/orb-home
mount "$disk" /mnt/orb-home
if [ ! -e /mnt/orb-home/.orb-home ]; then
  cp -a /home/user/. /mnt/orb-home/
  chown -R user:user /mnt/orb-home
  touch /mnt/orb-home/.orb-home
fi
umount /mnt/orb-home
mount "$disk" /home/user
