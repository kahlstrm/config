#!/bin/sh
# Updates the orb's Amp CLI without ever leaving a broken one behind: `amp update`
# writes to $HOME/.amp/bin/amp in place, so it runs against a staging HOME, and
# the new CLI replaces the orb's with a rename once it runs.
set -eu
cli=/home/user/.amp/bin/amp
staging=/home/user/.cache/amp-orb-cli-update
latest=$(curl -fsSL --max-time 10 https://static.ampcode.com/cli/cli-version.txt)
case "$("$cli" --version 2>/dev/null)" in "$latest"*) exit 0 ;; esac
rm -rf "$staging"
mkdir -p "$staging"
HOME=$staging "$cli" update
"$staging/.amp/bin/amp" --version >/dev/null
mv -f "$staging/.amp/bin/amp" "$cli"
rm -rf "$staging"
