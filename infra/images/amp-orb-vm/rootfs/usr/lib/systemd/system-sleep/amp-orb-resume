#!/bin/sh
# After a paused orb resumes from hibernation, bring its network back, take the
# new spawn's token and reconnect to the thread; processes kept running. Then,
# outside the hibernate unit, give the swap blocks of the memory image back.
# Operators and the bench read these lines in KubeVirt's guest-console-log.
if [ "$1" = pre ] && [ "$2" = hibernate ]; then echo "amp-orb: hibernating" >/dev/console; exit 0; fi
[ "$1" = post ] && [ "$2" = hibernate ] || exit 0
echo "amp-orb: resumed" >/dev/console
# With the TSC clocksource the restored clock runs ahead by how long the orb ran
# before the pause; the new VM's RTC has the host's time.
date -s "@$(cat /sys/class/rtc/rtc0/since_epoch)" >/dev/null
# The new VM's TCO watchdog (QEMU and libvirt add one to q35) runs from power-on;
# at a cold boot iTCO_wdt stops it, but the restored kernel thinks it is already
# stopped and the VM resets about 20 s later. Arm and close it to stop it.
for watchdog in /dev/watchdog[0-9]*; do
	[ -e "$watchdog" ] && printf V >"$watchdog"
done
# HibernateMode=shutdown skips ACPI's wake path, which re-enables the power
# button; without it, the next pause would not reach the guest.
echo enable >/sys/firmware/acpi/interrupts/ff_pwr_btn
for link in /sys/class/net/en* /sys/class/net/eth*; do
	[ -e "$link" ] && networkctl reconfigure "${link##*/}"
done
/lib/systemd/systemd-networkd-wait-online --timeout=15 || true
systemctl reset-failed amp-headless-bootstrap.service
systemctl restart --no-block amp-headless-bootstrap.service
systemctl start --no-block amp-orb-cli-update.service
systemd-run --no-block --unit=amp-orb-swap-trim --description="Free the orb's hibernation image" \
	sh -c 'swapoff /dev/disk/by-id/virtio-swap && blkdiscard -f /dev/disk/by-id/virtio-swap && /usr/local/sbin/amp-orb-swap'
exit 0
