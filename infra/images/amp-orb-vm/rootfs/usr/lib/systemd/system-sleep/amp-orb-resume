#!/bin/sh
# After a paused orb resumes from hibernation, bring its network back, take the
# new spawn's token and reconnect to the thread; processes kept running. Then,
# outside the hibernate unit, give the swap blocks of the memory image back.
[ "$1" = post ] && [ "$2" = hibernate ] || exit 0
# The power button press that paused the orb can still be queued; ignore it
# for a moment, or the orb would hibernate again right after waking.
systemd-run --no-block --unit=amp-orb-resume-holdoff --description="Ignore a stale power button press" \
	systemd-inhibit --what=handle-power-key --mode=block --why="just resumed" sleep 15
for link in /sys/class/net/en* /sys/class/net/eth*; do
	[ -e "$link" ] && networkctl reconfigure "${link##*/}"
done
/lib/systemd/systemd-networkd-wait-online --timeout=15 || true
/usr/local/sbin/amp-orb-env
systemctl reset-failed amp-headless-bootstrap.service
systemctl restart --no-block amp-headless-bootstrap.service
systemctl start --no-block amp-orb-cli-update.service
systemd-run --no-block --unit=amp-orb-swap-trim --description="Free the orb's hibernation image" \
	sh -c 'swapoff /dev/disk/by-id/virtio-swap && blkdiscard -f /dev/disk/by-id/virtio-swap && /usr/local/sbin/amp-orb-swap'
exit 0
