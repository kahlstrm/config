# Amp's orb image made bootable for KubeVirt: Debian's kernel and initramfs,
# networkd for the VM's NIC, and services that set up the home disk and start
# `amp orb bootstrap` with the token the dispatch program attaches as a disk.
# Docker starts on first use through its socket, as Amp's image ships it disabled.
FROM us-central1-docker.pkg.dev/amp-prod-0/amp-orb/amp-orb@sha256:2e2bf015cb071c1154004a06ebbdbb23bf966d3b7873133c362b7e1b31da56ae

USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      linux-image-amd64 initramfs-tools systemd-sysv systemd-resolved udev qemu-guest-agent e2fsprogs \
 && rm -rf /var/lib/apt/lists/*
COPY rootfs/ /
# COPY takes modes from the build context, so set the ones these files need.
RUN chmod 0755 /etc /etc/systemd /etc/systemd/system /etc/systemd/network /etc/initramfs-tools \
      /etc/systemd/system/amp-headless-bootstrap.service.d /usr /usr/local /usr/local/sbin \
      /usr/local/sbin/amp-orb-home /usr/local/sbin/amp-orb-env \
 && chmod 0644 /etc/systemd/system/amp-orb-*.service /etc/systemd/system/amp-headless-bootstrap.service.d/orb.conf \
      /etc/systemd/network/80-orb.network /etc/initramfs-tools/modules \
 && update-initramfs -u -k all \
 && systemctl enable systemd-networkd systemd-resolved qemu-guest-agent amp-orb-home amp-orb-env amp-headless-bootstrap docker.socket
