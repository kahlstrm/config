# Amp's orb image made bootable for KubeVirt: Debian's kernel and an initramfs
# that overlays the read-only image with the orb's state disk, networkd for the
# VM's NIC, hibernation to a swap disk on pause, and services that start
# `amp orb bootstrap` with the token the dispatch program attaches as a disk.
# Docker starts on first use through its socket, as Amp's image ships it disabled.
# mise's shims run the Node.js version each project asks for; Node.js 24 comes
# preinstalled, and other versions install on first use.
FROM us-central1-docker.pkg.dev/amp-prod-0/amp-orb/amp-orb@sha256:2e2bf015cb071c1154004a06ebbdbb23bf966d3b7873133c362b7e1b31da56ae

USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      linux-image-amd64 initramfs-tools busybox systemd-sysv systemd-resolved udev qemu-guest-agent e2fsprogs docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/*
ARG MISE_VERSION=2026.10.23
RUN curl -fsSLo /usr/local/bin/mise "https://github.com/jdx/mise/releases/download/v$MISE_VERSION/mise-v$MISE_VERSION-linux-x64" \
 && echo "a6ac620e73fb58cefbdfef8fb154856fbd8ae08d75ae88103e4b81daef3a836e  /usr/local/bin/mise" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/mise
# COPY takes modes from the build context, so normalize them before installing.
COPY rootfs/ /tmp/rootfs/
RUN find /tmp/rootfs -type d -exec chmod 0755 {} + \
 && find /tmp/rootfs -type f -exec chmod 0644 {} + \
 && chmod 0755 /tmp/rootfs/usr/local/sbin/* /tmp/rootfs/usr/lib/systemd/system-sleep/* \
      /tmp/rootfs/etc/initramfs-tools/hooks/* /tmp/rootfs/etc/initramfs-tools/scripts/local-bottom/* \
 && cp -a /tmp/rootfs/. / \
 && rm -rf /tmp/rootfs \
 && update-initramfs -u -k all \
 && runuser -u user -- env HOME=/home/user mise install node@24 \
 && rm -rf /home/user/.cache/mise \
 && systemctl enable systemd-networkd systemd-resolved qemu-guest-agent \
      amp-orb-swap var-lib-docker.mount var-lib-containerd.mount amp-headless-bootstrap amp-orb-cli-update amp-orb-trash amp-orb-state-sync docker.socket
